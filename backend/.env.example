APP_NAME=AI-Knowledge-Hub

APP_ENV=dev

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ai_knowledge_hub
DB_PASSWORD=change_me_application_password
DB_NAME=ai_knowledge_hub

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me_redis_password
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ACTIVE_KEY_ID=v1
JWT_SIGNING_KEYS={"v1":"replace_with_a_random_secret_at_least_32_chars"}

SESSION_EXPIRATION_MODE=absolute
SESSION_TTL_DAYS=7
SESSION_ABSOLUTE_MAX_DAYS=30

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_MINIO_ENDPOINT=http://127.0.0.1:9000
STORAGE_MINIO_ACCESS_KEY=ai_knowledge_hub_app
STORAGE_MINIO_SECRET_KEY=change_me_minio_application_secret
STORAGE_MINIO_BUCKET=ai-knowledge-hub-files
MAX_UPLOAD_SIZE_BYTES=20971520
UPLOAD_CHUNK_SIZE_BYTES=1048576
